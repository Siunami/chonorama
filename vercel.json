{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node chronorama/build.mjs",
  "outputDirectory": "chronorama/dist",
  "installCommand": "",
  "headers": [
    {
      "source": "/output/(.*).jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
